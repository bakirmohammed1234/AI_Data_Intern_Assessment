    {
      "parameters": {
        "jsCode": "// Assume the JSON string is in input item under the path: candidates[0].content.parts[0].text\nfunction cleanJsonString(str) {\n  return str\n    .replace(/^```json\\s*/i, \"\") // remove ```json at start\n    .replace(/^```\\s*/i, \"\")     // if it's only ``` at start\n    .replace(/\\s*```$/i, \"\");    // remove trailing ```\n}\n\n\nconst jsonString = $input.first().json.content.parts[0].text\n\nconst cleanData = cleanJsonString(jsonString)\n\n// Parse the string into a JSON object\n\n\n\n\nconst obj = JSON.parse(cleanData);\n// Return the object as an item\nreturn [{ cleanData: obj }];"
      },
