    {
      "parameters": {
        "jsCode": "const data = $input.all(); // array of items from previous nodes\n\nfunction cleanJsonString(str) {\n  if (typeof str !== 'string') return str;\n  return str\n    .replace(/^\\s*```json\\s*/i, \"\") // remove ```json at start (with possible leading whitespace)\n    .replace(/^\\s*```\\s*/i, \"\")     // remove bare ``` at start\n    .replace(/\\s*```\\s*$/i, \"\")     // remove trailing ```\n    .trim();\n}\n\nconst result = {}; // will hold parsed objects keyed by company_name or index\nlet idx = 0;\n\nfor (const item of data) {\n  const parts = item?.json?.content?.parts;\n\n  if (!parts) {\n    // if there's no parts array, skip but keep a note\n    continue;\n  }\n\n  // parts may be an array of strings or objects with `.text`\n  for (const part of parts) {\n    const rawText = (part && typeof part === 'object') ? (part.text ?? part) : part;\n    if (!rawText) continue;\n\n    const cleaned = cleanJsonString(rawText);\n\n    try {\n      const parsed = JSON.parse(cleaned);\n      // choose a sensible key for the map\n      const key = parsed.company_name || parsed.company || parsed.name || `company_${idx}`;\n      result[key] = parsed;\n    } catch (err) {\n      // store error info so you can debug bad outputs from the model\n      result[`parse_error_${idx}`] = {\n        error: err.message,\n        snippet: (typeof cleaned === 'string') ? cleaned.slice(0, 1000) : cleaned\n      };\n    }\n    idx++;\n  }\n}\n\n// n8n code node expects an array of items. Return one item with json=result\nreturn [{ data: result }];\n"
      },
