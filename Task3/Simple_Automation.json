            {
              "content": "={{ $json.data }}"
            }
          ]
        },
        "options": {
          "systemMessage": "=Extract structured events from the following RSS <item>.  Identify: - company/organization names - event type (choose strictly from: \"hiring\", \"funding\", \"partnership\", \"acquisition\", \"product launch\", \"layoffs\", \"merger\", \"investment\", \"expansion\", \"IPO\", \"bankruptcy\", \"shutdown\") - event date (if present in pubDate or text) - source (from <source> if available)\nReturn a JSON array with this schema:\n[\n  {\n    \"company\": \"...\",\n    \"event_type\": \"...\",\n    \"description\": \"...\",\n    \"confidence\": 0.0,\n    \"date\": \"...\",\n    \"source\": \"...\",\n    \"url\": \"...\"\n  }\n]"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        -240,
        -48
      ],
      "id": "5404acf1-5b10-41a9-bfac-5e5730d3f6ad",
      "name": "Message a model",
      "credentials": {
        "googlePalmApi": {
          "id": "QbPmzyioRhhvjkXp",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const keywords = [\n  // Finance / levées de fonds\n  \"funding\", \"investment\", \"seed round\", \"series a\", \"series b\", \"series c\",\n  \"pre-seed\", \"venture capital\", \"vc firm\", \"angel investor\", \"equity financing\",\n  \"debt financing\", \"ipo\", \"initial public offering\", \"going public\", \"valuation\",\n  \"unicorn\", \"merger\", \"acquisition\", \"m&a\", \"takeover\", \"buyout\", \"joint venture\",\n\n  // Croissance & stratégie\n  \"expansion\", \"scaling\", \"market entry\", \"new office\", \"international expansion\",\n  \"franchise\", \"strategic alliance\", \"partnership\", \"collaboration\", \"strategic deal\",\n  \"joint initiative\",\n\n  // RH / emploi\n  \"hiring\", \"recruiting\", \"recruitment\", \"talent acquisition\", \"job openings\",\n  \"new roles\", \"executive hire\", \"c-level hire\", \"appointed\", \"promotion\", \"resigned\",\n  \"stepping down\", \"layoffs\", \"downsizing\", \"workforce reduction\", \"mass firing\",\n  \"job cuts\", \"staffing\",\n\n  // Produits & innovation\n  \"product launch\", \"new release\", \"rollout\", \"innovation\", \"prototype\", \"beta test\",\n  \"pilot project\", \"new feature\", \"platform update\", \"tech breakthrough\", \"ai model\",\n  \"research and development\", \"patent filed\", \"patent granted\",\n\n  // Réglementaire & légal\n  \"lawsuit\", \"legal dispute\", \"regulatory approval\", \"fda approval\", \"compliance\",\n  \"antitrust\", \"litigation\", \"settlement\",\n\n  // Stratégie corporate\n  \"restructuring\", \"spin-off\", \"divestiture\", \"rebranding\", \"renamed\",\n  \"corporate transformation\", \"reorganization\",\n\n  // Awards & reconnaissance\n  \"award\", \"recognized as\", \"ranked\", \"listed on\", \"fortune 500\", \"fastest growing\",\n  \"best workplace\",\n\n  // Autres signaux stratégiques\n  \"contract won\", \"government deal\", \"tender\", \"grant\", \"secured funding\",\n  \"sponsorship\", \"partnership agreement\", \"strategic cooperation\"\n];\n\n// 🔹 Récupère le texte brut depuis ton input\nlet rawArticles = $input.first().json.cleanData;\n\n// 🔹 S'assurer que c'est bien un tableau JSON\nlet articles;\ntry {\n  articles = JSON.parse(rawArticles);\n} catch (e) {\n  articles = Array.isArray(rawArticles) ? rawArticles : [];\n}\n\nif (!Array.isArray(articles)) {\n  return [];\n}\n\n// 🔹 Filtrage par keywords (title + description + content si dispo)\nconst lowerKeywords = keywords.map(k => k.toLowerCase());\n\narticles\n  .filter(article => {\n    const text = (\n      (article.description || \"\")\n    ).toLowerCase();\n    return lowerKeywords.some(k => text.includes(k));\n  })\n  .map(article => ({ json: article }));\n\nreturn {cleanData: articles}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
