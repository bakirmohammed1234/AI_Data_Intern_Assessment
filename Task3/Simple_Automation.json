    {
      "parameters": {
        "content": "Example Use Case:\n\nWhen a company is mentioned in industry news (e.g. hiring, partnerships, funding, etc.), automatically:\n\n● Enrich company details\n● Find relevant contacts (e.g., Head of Marketing)\n● Send the info to the Sales team via Slack or Email\n",
        "height": 304,
        "width": 976
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        992,
        -160
      ],
      "id": "425ac1b2-24a7-47bf-8329-eaa59b4cb506",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-2.5-pro",
          "mode": "list",
          "cachedResultName": "models/gemini-2.5-pro"
        },
